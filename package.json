{
  "name": "jungle-gaming-distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor - Jungle Gaming technical challenge",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/infra/database/data-source.ts",
    "migration:generate": "bun run typeorm migration:generate",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:all": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.637.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.13",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "bun-types": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "ts-node": "^10.9.2"
  }
}
