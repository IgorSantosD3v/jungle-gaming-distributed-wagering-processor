# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering
DB_LOGGING=false

# AWS / SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
# Fila de ENTRADA — pedidos de transação chegando dos provedores (consumida pela app)
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# Dead-letter queue da fila de entrada — usada só para a métrica sqs_dlq_depth
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Fila de SAÍDA — eventos de domínio publicados pela app (separada de propósito, ver ARCHITECTURE.md)
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# App
PORT=3000
